<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
		<PackageReference Include="NetCord" Version="1.0.0-beta.28" />
		<PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.28" />
		<PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.28" />
		<PackageReference Include="Google.Apis.YouTube.v3" Version="1.77.0.4309" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
