<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<UserSecretsId>986c2036-1afc-4b78-bf64-210f71c0baec</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
		<PackageReference Include="NetCord" Version="1.0.0-beta.28" />
		<PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.28" />
		<PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.28" />
		<PackageReference Include="Google.Apis.YouTube.v3" Version="1.77.0.4309" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="usersettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="appsettings*.json;usersettings.json" Condition="'$(ExcludeLocalConfigurationFromPublish)' == 'true'">
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</None>
	</ItemGroup>

</Project>
